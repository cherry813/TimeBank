{
  "name": "campus-time-bank",
  "version": "1.0.0",
  "private": true,
  "description": "校园技能与时间互换平台",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vue-tsc --noEmit -p client/tsconfig.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "start": "node dist/server/src/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.0.6"
  }
}
